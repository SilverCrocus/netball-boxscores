# Database (local/disposable PostgreSQL example; Render supplies Supabase URLs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/centrepass_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/centrepass_dev"

# Runtime safety
# Set explicitly to local/development/test/staging/production before enabling polling.
DATABASE_ENVIRONMENT=""
# Disabled by default so a fresh dev server never polls or writes in the background.
WORKER_ENABLED="false"
# Keep false. This is an exceptional acknowledgement for a non-production
# process intentionally sharing the production database writer.
ALLOW_SHARED_PRODUCTION_DB_WRITES="false"

# Give each worktree its own port and keep NEXTAUTH_URL in sync.
PORT="3000"

# Optional: let localhost read the public hosted score API over HTTPS when a
# local PostgreSQL connection is unavailable. This is ignored in production.
CENTREPASS_PREVIEW_DATA_MODE=""
CENTREPASS_UPSTREAM_ORIGIN="https://www.centrepass.io"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Public statistical query endpoint
# HMAC secret used to create daily-rotating, non-reversible rate-limit keys.
STATS_RATE_LIMIT_SECRET="generate-a-separate-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Champion Data
CHAMPION_DATA_BASE_URL="https://mc.championdata.com/data"

# TheSportsDB
THESPORTSDB_API_KEY=""
THESPORTSDB_BASE_URL="https://www.thesportsdb.com/api/v1/json"
