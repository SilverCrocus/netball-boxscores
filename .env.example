# Database (local/disposable PostgreSQL example; Render supplies Supabase URLs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/centrepass_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/centrepass_dev"

# Runtime safety
# Set explicitly to local/development/test/staging/production before enabling polling.
DATABASE_ENVIRONMENT=""
# Disabled by default so a fresh dev server never polls or writes in the background.
WORKER_ENABLED="false"
# Development-only live-match simulation. Requires WORKER_ENABLED=true and a
# disposable local database; production and staging reject it.
SIMULATION_MODE="false"
# Keep false. This is an exceptional acknowledgement for a non-production
# process intentionally sharing the production database writer.
ALLOW_SHARED_PRODUCTION_DB_WRITES="false"

# Give each worktree its own port and keep NEXTAUTH_URL in sync.
PORT="3000"

# Optional: let localhost read the public hosted score API over HTTPS when a
# local PostgreSQL connection is unavailable. This is ignored in production.
CENTREPASS_PREVIEW_DATA_MODE=""
CENTREPASS_UPSTREAM_ORIGIN="https://www.centrepass.io"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Private analytics and Ask CentrePass boundaries. Both features fail closed
# unless explicitly enabled; never reuse DATABASE_URL for either scoped URL.
ANALYTICS_FEATURES_ENABLED="false"
ASK_CENTREPASS_ENABLED="false"
# Runtime URLs must point to the Supavisor transaction pooler (normally port
# 6543). The app enforces pgbouncer=true, connection_limit=5 (analytics) or 2
# (operations), and pool_timeout=5. DIRECT_URL remains direct/session mode.
ANALYTICS_DATABASE_URL=""
STATS_OPERATIONS_DATABASE_URL=""
# At least 32 random characters. Used for domain-separated HMACs only; raw
# client identifiers and natural-language questions are never persisted.
STATS_RATE_LIMIT_SECRET="generate-a-separate-secret-of-at-least-32-characters"

# Fail-closed private DRAFT preview. Enable only for a bounded QA window and
# use stable server-side NextAuth user IDs; never expose this allowlist to the client.
DRAFT_PREVIEW_ENABLED="false"
DRAFT_PREVIEW_OPERATOR_IDS=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Champion Data
CHAMPION_DATA_BASE_URL="https://mc.championdata.com/data"

# TheSportsDB
THESPORTSDB_API_KEY=""
THESPORTSDB_BASE_URL="https://www.thesportsdb.com/api/v1/json"
